# ===== Unity =====
# Funciona para cualquier proyecto Unity dentro de subcarpetas del repo
# Carpetas que Unity regenera solo (NO se suben)
**/[Ll]ibrary/
**/[Tt]emp/
**/[Oo]bj/
**/[Bb]uild/
**/[Bb]uilds/
**/[Ll]ogs/
**/[Uu]ser[Ss]ettings/
**/[Mm]emoryCaptures/
**/[Rr]ecordings/

# Asset Store Tools
**/[Aa]ssets/AssetStoreTools*

# Plugins autogenerados
**/[Aa]ssets/Plugins/Editor/JetBrains*

# Archivos de IDE (Visual Studio / Rider / VS Code)
.vs/
.idea/
.vscode/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Metas de archivos ignorados
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Crash reports
sysinfo.txt

# Builds
*.apk
*.aab
*.unitypackage
*.app

# Addressables / caches
**/[Aa]ssets/[Ss]treamingAssets/aa.meta
**/[Aa]ssets/[Ss]treamingAssets/aa/*
crashlytics-build.properties

# ===== Sistema operativo =====
.DS_Store
Thumbs.db
desktop.ini

